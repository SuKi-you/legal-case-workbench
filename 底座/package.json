{
  "name": "@law-agent/foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Legal agent runtime with a plugin host and built-in material abilities",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.ts",
    "demo": "node examples/demo.ts",
    "demo:materials": "node examples/materials-demo.ts",
    "materials:text": "node examples/material-text.ts",
    "demo:versions": "node examples/version-reference-demo.ts",
    "cases": "node examples/cases.ts",
    "demo:cases": "node examples/case-workspace-demo.ts",
    "demo:rollback": "node examples/case-rollback-demo.ts",
    "demo:loop": "node examples/intake-loop-demo.ts",
    "information": "node --env-file-if-exists=.env.local examples/information.ts",
    "demo:information": "node --env-file-if-exists=.env.local examples/information-demo.ts",
    "agent": "node --env-file-if-exists=.env.local examples/agent.ts",
    "demo:agent": "node --env-file-if-exists=.env.local examples/agent-demo.ts",
    "outputs": "node examples/outputs.ts",
    "demo:outputs": "node examples/output-demo.ts",
    "agent:labor": "node --env-file-if-exists=.env.local examples/agent.ts --plugin ../劳动法插件/src/index.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "docx": "9.15.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
